# Copy this file to .env and fill in your own values. .env is per-machine
# and must never be committed — it identifies your GNOME Online Accounts entry.

# The GOA keyring identity for your Microsoft 365 account, in the form
# "<provider>:gen1:<account id>". Find it with:
#   grep -A2 '\[Account ' ~/.config/goa-1.0/accounts.conf
# then match the account id against the "goa-identity" attribute on the
# matching secret item:
#   python3 -c "
#   import gi; gi.require_version('Secret','1'); from gi.repository import Secret
#   svc = Secret.Service.get_sync(Secret.ServiceFlags.LOAD_COLLECTIONS)
#   for c in svc.get_collections():
#       for i in c.get_items():
#           print(i.get_label(), dict(i.get_attributes()))
#   "
GOA_IDENTITY="ms_graph:gen1:account_XXXXXXXXXX_0"

# Where the extracted GRAPH_REFRESH_TOKEN gets written for systemd to import.
# Optional — defaults to ~/.config/environment.d/akonadi-ms365.conf.
OUTPUT_ENV_FILE="$HOME/.config/environment.d/akonadi-ms365.conf"
